{
  "name": "funscript",
  "version": "0.1.0",
  "description": "Indentation-based functional notation compiling to TypeScript for the Effect + ts-pattern + Mutative ecosystem",
  "type": "module",
  "bin": {
    "funscript": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./prettier": "./dist/formatter/prettier.js",
    "./prettier-plugin-funscript": "./dist/formatter/prettier.js",
    "./record": "./dist/interop/record.js",
    "./zod": "./dist/interop/zod.js",
    "./interop/zod": "./dist/interop/zod.js",
    "./valibot": "./dist/interop/valibot.js",
    "./interop/valibot": "./dist/interop/valibot.js",
    "./vite": "./dist/plugins/vite.js",
    "./plugins/vite": "./dist/plugins/vite.js"
  },
  "scripts": {
    "build": "tsc && tsc -p editors/vscode",
    "check": "tsc --noEmit",
    "benchmark": "node scripts/benchmark.mjs",
    "test": "vitest run --maxWorkers=2 --minWorkers=1",
    "test:examples": "vitest run tests/example-apps-build.test.ts",
    "test:watch": "vitest",
    "fmt": "node ./dist/cli/index.js fmt",
    "fmt:check": "node ./dist/cli/index.js fmt --check examples/fixtures/*.fun examples/solid-demo/*.fun examples/greeter-service.fun examples/hello.fun examples/order-fulfillment.fun examples/shapes.fun examples/todo-http.fun examples/fibonacci.fun examples/bank-account.fun examples/todo-service.fun examples/js-ts-interop.fun examples/markdown-task-manager.fun examples/pipeline-helpers.fun examples/todo-dashboard.funx examples/ts-schema-validation.fun examples/rest-api-server.fun examples/sqlite-repository.fun tests/fixtures/formatter/*.funx",
    "prettier:check": "prettier --plugin ./dist/formatter/prettier.js --check examples/hello.fun tests/fixtures/formatter/*.funx docs/ci-release.md",
    "docs:generate": "npm run build && node scripts/generate-reference-docs.mjs",
    "docs:check": "npm run build && node scripts/generate-reference-docs.mjs --check",
    "check:idiomatic": "node scripts/check-idiomatic.mjs",
    "verify": "npm run build && npm run fmt:check && npm test",
    "pr:check": "node scripts/validate-pr.js",
    "package:check": "node scripts/check-package.mjs"
  },
  "keywords": [
    "funscript",
    "functional-programming",
    "typescript",
    "effect",
    "ts-pattern",
    "mutative",
    "compiler"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/code-frame": "^7.29.7",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@total-typescript/ts-reset": "^0.6.1",
    "assemblyscript": "^0.28.20",
    "effect": "^4.1.2",
    "es-toolkit": "^1.53.2",
    "magic-string": "^1.4.5",
    "mutative": "^1.1.0",
    "ts-pattern": "^5.5.0",
    "type-fest": "^5.10.0",
    "typescript": "^5.6.3",
    "valibot": "^1.5.0",
    "vite": "^5.4.21",
    "vscode-languageclient": "^11.0.0",
    "vscode-languageserver": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@effect/platform-node": "^4.1.2",
    "@effect/sql-sqlite-node": "^4.1.2",
    "@types/babel__code-frame": "^7.27.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.3.0",
    "@types/vscode": "^1.140.0",
    "pino": "^10.4.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "solid-js": "^1.9.18",
    "vitest": "^2.1.3"
  },
  "files": [
    "dist/",
    "src/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  }
}
