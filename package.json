{
  "name": "funscript",
  "version": "0.1.0",
  "description": "Indentation-based functional notation compiling to TypeScript for the Effect + ts-pattern + Mutative ecosystem",
  "type": "module",
  "bin": {
    "funscript": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./prettier": "./dist/formatter/prettier.js",
    "./prettier-plugin-funscript": "./dist/formatter/prettier.js",
    "./vite": "./dist/plugins/vite.js",
    "./plugins/vite": "./dist/plugins/vite.js"
  },
  "scripts": {
    "build": "tsc && tsc -p editors/vscode",
    "benchmark": "node scripts/benchmark.mjs",
    "test": "vitest run",
    "test:examples": "vitest run tests/example-apps-build.test.ts",
    "test:watch": "vitest",
    "fmt": "node ./dist/cli/index.js fmt",
    "fmt:check": "node ./dist/cli/index.js fmt --check examples/fixtures/*.fun examples/solid-demo/*.fun examples/greeter-service.fun examples/hello.fun examples/order-fulfillment.fun examples/shapes.fun examples/todo-http.fun examples/fibonacci.fun examples/bank-account.fun examples/todo-service.fun examples/js-ts-interop.fun examples/markdown-task-manager.fun examples/todo-dashboard.funx examples/ts-schema-validation.fun tests/fixtures/formatter/*.funx",
    "prettier:check": "prettier --plugin ./dist/formatter/prettier.js --check examples/hello.fun tests/fixtures/formatter/*.funx docs/ci-release.md",
    "docs:generate": "npm run build && node scripts/generate-reference-docs.mjs",
    "docs:check": "node scripts/generate-reference-docs.mjs --check",
    "verify": "npm run build && npm run fmt:check && npm test",
    "pr:check": "node scripts/validate-pr.js"
  },
  "keywords": [
    "funscript",
    "functional-programming",
    "typescript",
    "effect",
    "ts-pattern",
    "mutative",
    "compiler"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/code-frame": "^7.29.7",
    "@jridgewell/trace-mapping": "^0.3.31",
    "effect": "^4.1.1",
    "magic-string": "^1.4.5",
    "mutative": "^1.1.0",
    "ts-pattern": "^5.5.0",
    "typescript": "^5.6.3",
    "vscode-languageclient": "^11.0.0",
    "vscode-languageserver": "^11.0.0"
  },
  "devDependencies": {
    "@types/babel__code-frame": "^7.27.0",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.140.0",
    "prettier": "^3.9.10",
    "solid-js": "^1.9.18",
    "vitest": "^2.1.3"
  }
}
