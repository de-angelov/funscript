{
  "name": "funscript",
  "version": "0.1.0",
  "description": "Indentation-based functional notation compiling to TypeScript for the Effect + ts-pattern + Mutative ecosystem",
  "type": "module",
  "bin": {
    "funscript": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./prettier": "./dist/formatter/prettier.js",
    "./prettier-plugin-funscript": "./dist/formatter/prettier.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt": "node ./dist/cli/index.js fmt",
    "fmt:check": "node ./dist/cli/index.js fmt --check examples/*.fun programs/*.fun",
    "prettier:check": "prettier --check \"**/*.fun\""
  },
  "keywords": [
    "funscript",
    "functional-programming",
    "typescript",
    "effect",
    "ts-pattern",
    "mutative",
    "compiler"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "effect": "^3.10.16",
    "magic-string": "^1.4.5",
    "mutative": "^1.1.0",
    "ts-pattern": "^5.5.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/node": "^20.17.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
