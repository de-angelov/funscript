{
  "name": "funscript",
  "version": "0.1.0",
  "description": "Indentation-based functional notation compiling to TypeScript for the Effect + ts-pattern + Mutative ecosystem",
  "type": "module",
  "bin": {
    "funscript": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "funscript",
    "functional-programming",
    "typescript",
    "effect",
    "ts-pattern",
    "mutative",
    "compiler"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "effect": "^3.10.16",
    "mutative": "^1.1.0",
    "ts-pattern": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
