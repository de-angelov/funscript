{
  "name": "funscript",
  "version": "0.2.3",
  "description": "Indentation-based functional notation compiling to TypeScript for the Effect + ts-pattern + Mutative ecosystem",
  "type": "module",
  "bin": {
    "funscript": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./prettier": "./dist/formatter/prettier.js",
    "./record": "./dist/interop/record.js",
    "./zod": "./dist/interop/zod.js",
    "./valibot": "./dist/interop/valibot.js",
    "./vite": "./dist/plugins/vite.js",
    "./bun": "./dist/plugins/bun.js",
    "./bun/preload": "./dist/plugins/bun-preload.js",
    "./esbuild": "./dist/plugins/esbuild.js",
    "./test": "./dist/testing/index.js",
    "./callback": "./dist/interop/callback.js"
  },
  "scripts": {
    "build": "tsc && tsc -p editors/vscode",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "benchmark": "node scripts/benchmark.mjs",
    "test": "vitest run --maxWorkers=8 --minWorkers=1 --exclude '**/tests/{benchmark*,example-apps-build,examples-rest-server}*'",
    "test:fast": "vitest run tests/parser.test.ts tests/parser-jsx.test.ts tests/lexer.test.ts tests/lexer-jsx.test.ts tests/formatter.test.ts tests/cli-help.test.ts tests/lsp-imports.test.ts tests/lsp-match-arms.test.ts tests/lsp-inlay-hints.test.ts",
    "test:unit": "vitest run --maxWorkers=8 --minWorkers=1 --exclude '**/tests/{*cli*,*examples*,*benchmark*,*repl*,*sourcemap*,*toolchain*,*vscode*,*check-idiomatic*}*'",
    "test:examples": "vitest run --maxWorkers=4 --minWorkers=1 tests/example-apps-build.test.ts tests/examples-rest-server.test.ts tests/examples-sqlite.test.ts",
    "test:watch": "vitest",
    "fmt": "node ./dist/cli/index.js fmt",
    "fmt:check": "node ./dist/cli/index.js fmt --check src examples tests/fixtures/formatter",
    "fmt:ts": "prettier --write 'src/**/*.ts'",
    "fmt:ts:check": "prettier --check 'src/**/*.ts'",
    "lint": "eslint src editors/vscode/src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "knip": "npx --yes knip --reporter compact",
    "prettier:check": "prettier --plugin ./dist/formatter/prettier.js --check examples/hello.fun tests/fixtures/formatter/*.funx docs/ci-release.md",
    "docs:generate": "npm run build && node scripts/generate-reference-docs.mjs",
    "docs:check": "npm run build && node scripts/generate-reference-docs.mjs --check",
    "check:idiomatic": "node scripts/check-idiomatic.mjs",
    "verify": "npm run build && npm run fmt:check && npm test",
    "pr:check": "node scripts/validate-pr.js",
    "package:check": "node scripts/check-package.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "funscript",
    "functional-programming",
    "typescript",
    "effect",
    "ts-pattern",
    "mutative",
    "compiler"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@babel/code-frame": "^7.29.7",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@total-typescript/ts-reset": "^0.6.1",
    "assemblyscript": "^0.28.20",
    "diff": "^9.0.0",
    "effect": "^4.1.2",
    "es-toolkit": "^1.53.2",
    "esbuild": "^0.21.5",
    "fast-glob": "^3.3.3",
    "magic-string": "^1.4.5",
    "mutative": "^1.1.0",
    "ts-pattern": "^5.5.0",
    "type-fest": "^5.10.0",
    "typescript": "^5.6.3",
    "valibot": "^1.5.0",
    "vscode-languageserver": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/platform-node": "^4.1.2",
    "@effect/sql-sqlite-node": "^4.1.2",
    "@eslint/js": "^9.39.5",
    "@types/babel__code-frame": "^7.27.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^20.17.0",
    "@types/react": "^19.3.0",
    "@types/vscode": "^1.140.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino": "^10.4.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "solid-js": "^1.9.18",
    "typescript-eslint": "^8.73.0",
    "typescript71": "npm:typescript@^7.1.0-beta",
    "vite": "^5.4.21",
    "vitest": "^2.1.3",
    "vscode-languageclient": "^11.0.0"
  },
  "files": [
    "dist/",
    "src/",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "peerDependencies": {
    "vite": "^5.4.21 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
