import { Option } from "effect"
import { optionalProperties } from "funscript/record"

export RankingOrderControls = (props: {
  order: Omittable<String>
  onOrderChange: Omittable<(order: String) => Void>
}) =>
  order = Option.getOrElse(props.order, () => "highest-first")
  buttonProps = optionalProperties({ onClick: Option.map(props.onOrderChange, (change) => () => change("lowest-first")) })
  => <button {...buttonProps}>{order}</button>
