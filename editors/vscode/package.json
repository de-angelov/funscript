{
  "name": "funscript-vscode",
  "displayName": "FunScript",
  "description": "FunScript language support with syntax highlighting, language server, diagnostics, formatting, and snippets",
  "version": "0.1.0",
  "publisher": "funscript",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:funscript",
    "onLanguage:funscriptx",
    "onCommand:funscript.checkFile",
    "onCommand:funscript.formatFile",
    "onCommand:funscript.restartServer",
    "onCommand:funscript.openGeneratedTs"
  ],
  "contributes": {
    "languages": [
      {
        "id": "funscript",
        "aliases": [
          "FunScript",
          "funscript"
        ],
        "extensions": [
          ".fun"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "funscriptx",
        "aliases": [
          "FunScript JSX",
          "funscriptx"
        ],
        "extensions": [
          ".funx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "funscript",
        "scopeName": "source.fun",
        "path": "./syntaxes/funscript.tmLanguage.json"
      },
      {
        "language": "funscriptx",
        "scopeName": "source.funx",
        "path": "./syntaxes/funscript.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "funscript.checkFile",
        "title": "Check Current File",
        "category": "FunScript"
      },
      {
        "command": "funscript.formatFile",
        "title": "Format Current File",
        "category": "FunScript"
      },
      {
        "command": "funscript.restartServer",
        "title": "Restart Language Server",
        "category": "FunScript"
      },
      {
        "command": "funscript.openGeneratedTs",
        "title": "Open Generated TypeScript",
        "category": "FunScript"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "funscript.checkFile",
          "when": "editorLangId == funscript || editorLangId == funscriptx"
        },
        {
          "command": "funscript.formatFile",
          "when": "editorLangId == funscript || editorLangId == funscriptx"
        },
        {
          "command": "funscript.openGeneratedTs",
          "when": "editorLangId == funscript || editorLangId == funscriptx"
        },
        {
          "command": "funscript.restartServer"
        }
      ],
      "editor/title": [
        {
          "command": "funscript.openGeneratedTs",
          "when": "editorLangId == funscript || editorLangId == funscriptx",
          "group": "navigation"
        }
      ]
    },
    "snippets": [
      {
        "language": "funscript",
        "path": "./snippets/funscript.json"
      },
      {
        "language": "funscriptx",
        "path": "./snippets/funscript.json"
      }
    ],
    "configurationDefaults": {
      "[funscript]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "funscript.funscript-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit"
        }
      },
      "[funscriptx]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "funscript.funscript-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit"
        }
      }
    },
    "configuration": {
      "type": "object",
      "title": "FunScript",
      "properties": {
        "funscript.serverPath": {
          "type": "string",
          "default": "funscript",
          "description": "Path to the funscript executable for the LSP server and commands"
        },
        "funscript.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the FunScript language server."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.6.3"
  }
}
