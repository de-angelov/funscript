// Sample legacy function with comments
calculate = (x: Number) =>
  // calculate multiplier
  multiplier = 2
  temp = x * multiplier
  // return final computation
  temp + 1 // inline comment

// Multi-argument function with braced block
sumAndDouble = (a: Number, b: Number) => {
  sum = a + b
  sum * 2
}

// Single-line braced block
cube = (n: Number) => { n ** 3 }
